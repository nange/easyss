# Go source files must use LF for cross-platform gofmt compatibility
*.go text eol=lf

# Common text files: LF
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.mod text eol=lf
*.sum text eol=lf
Makefile text eol=lf

# Windows batch scripts: CRLF
*.bat text eol=crlf

# Binary files: no conversion
*.mmdb binary
*.png binary
*.ico binary
*.icns binary
*.dll binary
*.syso binary
*.zip binary
*.aar binary
